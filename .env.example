TRADE_MODE=demo
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=MetaQuotes-Demo
MT5_PATH=/Users/mohitshah/Applications/MetaTrader 5.app
SYMBOL=EURUSD
RISK_PCT=0.01
MAX_LOT=0.10
SL_PIPS=20
TP_PIPS=40
POLL_SECONDS=1
DASHBOARD_PORT=5055
MAX_POSITIONS=8
FILL_VENUE=mt5
HARD_BLOCK_LIVE=true
EXECUTION_MUTEX_REQUIRED=true
SESSION_START_HOUR=7
SESSION_END_HOUR=21
MIN_ATR_PIPS=1
MIN_SCORE=4
TAKE_ATR_MULT=1.5
STOP_ATR_MULT=1.5
WEEKEND_GUARD=true
WEEKEND_FLAT=true
STOP_COOLDOWN_MINUTES=5
MIN_ENTRY_SECONDS=60
MAX_SPREAD_PIPS=2.0
DEMO_START_BALANCE=100000
HISTORY_LOOKBACK_DAYS=0

# Empty = unlocked on localhost. Set a PIN before putting this on Cloudflare.
DESK_PIN=
# Same value as `wrangler secret put DESK_SECRET` if you deploy the Worker.
DESK_SECRET=
UI_ORIGIN=http://127.0.0.1:3000
DASHBOARD_HOST=127.0.0.1
DESK_COOKIE_SECURE=false
