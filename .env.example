TRADE_MODE=demo
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=MetaQuotes-Demo
MT5_PATH=/Users/mohitshah/Applications/MetaTrader 5.app
SYMBOL=EURUSD
SYMBOLS=EURUSD,GBPJPY,XAUUSD
RISK_PCT=0.01
MAX_LOT=0.10
SL_PIPS=20
TP_PIPS=40
POLL_SECONDS=1
DASHBOARD_PORT=5055
# Order magic. Give every bot sharing one MT5 login its own value, or they will
# claim and manage each other's positions. Defaults to 26082601.
MAGIC=26082601
MAX_POSITIONS=4
# Kotegawa/BNF: 1% per ticket (RISK_PCT), 2R take, daily halt at 2% equity.
# No profit-trail / giveback / % loss-cut overlay — broker SL/TP only.
DAILY_LOSS_PCT=0.02
FILL_VENUE=mt5
HARD_BLOCK_LIVE=true
EXECUTION_MUTEX_REQUIRED=true
SESSION_START_HOUR=7
SESSION_END_HOUR=20
SESSION_END_MINUTE=20
MIN_ATR_PIPS=4.0
MIN_ATR_PIPS_JPY=8.0
MIN_ATR_PIPS_XAU=500.0
MIN_SCORE=4
TAKE_ATR_MULT=1.5
STOP_ATR_MULT=1.5
WEEKEND_GUARD=true
WEEKEND_FLAT=true
STOP_COOLDOWN_MINUTES=5
MIN_ENTRY_SECONDS=300
MAX_SPREAD_PIPS=2.0
MAX_SPREAD_PIPS_JPY=4.0
MAX_SPREAD_PIPS_XAU=80.0
DEMO_START_BALANCE=100000
HISTORY_LOOKBACK_DAYS=0
# 0 = request MT5 deals from 2018-01-01 onward (unix 0 is ignored by the terminal).
# Only count MACD-strategy closes after this UTC instant (exclude old Bill era).
MACD_ERA_START=2026-09-03T00:00:00+00:00

# Strategy: macd (default Bill/Trading Rush) | day_range (CRT PDH/PDL) | vwap_ema (Austin VWAP+EMA9).
# Kronos agree-gate applies only when STRATEGY=macd. day_range and vwap_ema skip Kronos.
STRATEGY=vwap_ema
# Mid chop band = this fraction of (PDH-PDL) around mid (no trade).
DAY_RANGE_MID_BAND_PCT=0.05
# Prefer M15; set M5 if broker copy_rates lacks M15.
DAY_RANGE_TIMEFRAME=M15

# Empty = unlocked on localhost. Prefer an authenticator app (Google Authenticator / Authy).
# python scripts/desk_totp_enroll.py  — writes DESK_TOTP_SECRET and prints a scan URI / QR.
DESK_TOTP_SECRET=
# Show the setup QR on the lock screen even after the first unlock (recovery). Default off.
DESK_TOTP_SHOW_QR=false
# Set automatically after the first successful authenticator unlock. Hides the lock-screen QR.
DESK_TOTP_ENROLLED=
# Fallback only when DESK_TOTP_SECRET is empty.
DESK_PIN=
# Same value as `wrangler secret put DESK_SECRET` if you deploy the Worker.
DESK_SECRET=
UI_ORIGIN=http://127.0.0.1:3000
DASHBOARD_HOST=127.0.0.1
DESK_COOKIE_SECURE=false

# DEMO-ONLY Kronos-mini agree gate beside MACD (default off). Never live.
# Run: .venv/bin/python scripts/run_kronos_demo_filter.py
# Then set KRONOS_FILTER=true on demo after verifying data/kronos_decisions.json
KRONOS_FILTER=false
KRONOS_DECISIONS_PATH=
KRONOS_MAX_AGE_SEC=1800
# chop = no Kronos opinion. allow = MACD may fire (default). skip = old block-on-chop.
KRONOS_CHOP=allow
MAX_LOT_XAU=0.02

# Skip new XAUUSD tickets around USD CPI / NFP / FOMC / PCE. Not an entry engine.
NEWS_BLACKOUT=true
NEWS_BEFORE_MIN=30
NEWS_AFTER_MIN=20
NEWS_PAIRS=XAUUSD
# Quiet tape: MACD may still print, engine will not fire. ATR_GATE=false to ignore.
ATR_GATE=true
# First minutes after Sunday 21:00 UTC FX reopen.
MONDAY_OPEN_SKIP_MIN=30
